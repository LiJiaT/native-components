{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/self-evolve/distill-notify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/self-evolve/distill-enqueue.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
