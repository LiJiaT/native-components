{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/orchestrator/orchestrator-warmup.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/orchestrator/orchestrator-classify.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
