{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-basic-component/schemas/plan.schema.json",
  "title": "orchestrator plan",
  "type": "object",
  "required": ["goal", "constraints", "inputs", "outputs", "boundaries", "acceptance", "human_gates", "version"],
  "properties": {
    "goal": {"type": "string", "minLength": 8},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "human_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "version": {"type": "string", "minLength": 1},
    "plan_hash": {"type": "string"},
    "approval": {
      "type": "object",
      "properties": {
        "approver": {"type": "string"},
        "approved_at": {"type": "string"},
        "scope_hash": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
