{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-basic-component/schemas/promotion.schema.json",
  "title": "self-evolution promotion check",
  "type": "object",
  "required": ["schema_version", "candidate_id", "session_ids", "evidence",
               "failure_modes", "owner", "scope", "git", "target_path", "status"],
  "properties": {
    "schema_version": {"const": "1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "session_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "owner": {"type": "string", "minLength": 2},
    "scope": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {"enum": ["skill", "rule", "memory", "hook", "flow", "agent", "doc", "tool"]},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "git": {
      "type": "object",
      "required": ["repo", "commit", "clean"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "clean": {"const": true}
      },
      "additionalProperties": true
    },
    "target_path": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "rejected"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
