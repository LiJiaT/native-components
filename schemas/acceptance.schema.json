{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-basic-component/schemas/acceptance.schema.json",
  "title": "acceptance result",
  "type": "object",
  "required": ["task_id", "task_package", "task_package_sha256", "checklist_hash",
               "criteria", "verdict", "reviewer", "executor", "reviewer_run_id",
               "executor_run_id", "reviewer_inputs", "reviewed_at",
               "self_review", "artifact_sha256"],
  "properties": {
    "task_id": {"type": "string", "minLength": 2},
    "task_package": {"type": "string", "minLength": 1},
    "task_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checklist_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expected", "check_method", "evidence_path",
                     "evidence_sha256", "result"],
        "properties": {
          "id": {"type": "string"},
          "expected": {"type": "string", "minLength": 1},
          "check_method": {"enum": ["manual", "auto"]},
          "evidence_path": {"type": "string", "minLength": 1},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"enum": ["pass", "fail", "blocked"]},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "self_review": {
      "type": "object",
      "required": ["result", "evidence_path", "evidence_sha256"],
      "properties": {
        "result": {"enum": ["pass", "fail", "blocked"]},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "disposition"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "severity": {"enum": ["blocker", "major", "minor"]},
              "disposition": {"enum": ["fixed", "accepted", "rejected", "deferred", "open"]},
              "reason": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    "verdict": {"enum": ["pass", "fail", "blocked"]},
    "reviewer": {"type": "string", "minLength": 2},
    "executor": {"type": "string", "minLength": 2},
    "reviewer_run_id": {"type": "string", "minLength": 1},
    "executor_run_id": {"type": "string", "minLength": 1},
    "reviewer_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "independent": {"type": "boolean"},
    "reviewed_at": {"type": "string", "minLength": 8},
    "artifact_sha256": {"type": "object", "minProperties": 1}
  },
  "additionalProperties": true
}
