{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://native-components/schemas/review.schema.json",
  "title": "independent review result",
  "type": "object",
  "required": [
    "task_id",
    "task_package_sha256",
    "reviewer",
    "reviewer_model",
    "reviewer_run_id",
    "reviewed_at",
    "reviewed_artifact",
    "criteria",
    "verdict",
    "visible_inputs"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 2},
    "task_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "string", "minLength": 2},
    "reviewer_model": {"enum": ["GLM-5.3"]},
    "reviewer_run_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 8},
    "reviewed_artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result", "reason", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "blocked"]},
          "reason": {"type": "string", "minLength": 4},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "verdict": {"enum": ["pass", "fail", "blocked"]},
    "visible_inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
