{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-basic-component/schemas/acceptance.schema.json",
  "title": "acceptance result",
  "type": "object",
  "required": ["task_id", "criteria", "verdict", "reviewer", "executor", "reviewed_at"],
  "properties": {
    "task_id": {"type": "string", "minLength": 2},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expected", "evidence_path", "result"],
        "properties": {
          "id": {"type": "string"},
          "expected": {"type": "string", "minLength": 1},
          "evidence_path": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "blocked"]},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "verdict": {"enum": ["pass", "fail", "blocked"]},
    "reviewer": {"type": "string", "minLength": 1},
    "executor": {"type": "string", "minLength": 1},
    "independent": {"type": "boolean"},
    "reviewed_at": {"type": "string", "minLength": 8},
    "artifact_sha256": {"type": "object"}
  },
  "additionalProperties": true
}
