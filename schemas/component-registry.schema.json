{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-basic-component/schemas/component-registry.schema.json",
  "title": "public component registry",
  "type": "object",
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": {"const": "1"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "owner", "interface", "dependencies", "version", "status", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "type": {"enum": ["skill", "agent", "hook", "flow", "rule", "memory", "prompt", "gate", "schema", "tool", "doc"]},
          "owner": {"type": "string", "minLength": 2},
          "interface": {"type": "string", "minLength": 8},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["active", "experimental", "test-only", "deprecated", "withdrawn"]},
          "path": {"type": "string", "minLength": 1},
          "install_target": {"type": "string"},
          "install_dir": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "provenance_status": {"enum": ["verified", "source-excerpt", "synthetic", "n/a"]}
        },
        "additionalProperties": false
      }
    }
  }
}
