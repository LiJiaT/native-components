{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://native-components/schemas/plan.schema.json",
  "title": "engineering-agent plan",
  "type": "object",
  "required": ["goal", "constraints", "inputs", "outputs", "boundaries", "acceptance",
               "human_gates", "version", "requirement_card", "acceptance_criteria_hash"],
  "properties": {
    "goal": {"type": "string", "minLength": 8},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["id", "check_method", "expected", "evidence"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "check_method": {"enum": ["manual", "auto"]},
              "expected": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1},
              "check_script": {"type": "string"},
              "severity": {"enum": ["blocker", "major", "minor"]},
              "independent_review": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "human_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "version": {"type": "string", "minLength": 1},
    "requirement_card": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "acceptance_criteria_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_hash": {"type": "string"},
    "approval": {
      "type": "object",
      "required": ["approver", "approved_at", "scope_hash", "decision"],
      "properties": {
        "approver": {"type": "string", "minLength": 2},
        "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"},
        "scope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision": {"enum": ["approved", "rejected", "needs-revision"]},
        "approval_ref": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
